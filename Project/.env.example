# Copy to .env (and .env.local) and fill in. NEVER commit real values.

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/resort_info?schema=public"

# Public base URL of the site (used for QR links)
NEXT_PUBLIC_APP_URL="http://localhost:6001"

# Timezone standard for Vietnam (UTC+7)
TZ="Asia/Ho_Chi_Minh"

# Random secret used to salt hashed IPs stored with feedback.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=""

# Private storage for internal documents. Use an ABSOLUTE path OUTSIDE the app
# and outside public/. Back it up together with the database.
STORAGE_DIR="./storage"

# Session cookie "Secure" flag. Defaults to true in production (HTTPS required).
# Set to "false" only for plain-HTTP testing.
# COOKIE_SECURE="true"

# NOTE: ADMIN_PASSWORD no longer exists. Create the first account with:
#   npm run user:create -- --email you@example.com --name "Your Name" --role SUPER_ADMIN
