// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model QRCode {
  id          String    @id @default(cuid())
  name        String
  token       String    @unique
  description String?
  type        String    // "guest" | "staff" | "custom"
  isActive    Boolean   @default(true)
  modules     QRModule[]
  scans       QRCodeScan[]
  feedbacks   Feedback[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Module {
  id          String    @id @default(cuid())
  name        String    @unique // "menu", "floor-plan", etc.
  displayName String
  description String?
  icon        String?
  route       String
  isPublic    Boolean   @default(false)
  qrCodes     QRModule[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model QRModule {
  id        String   @id @default(cuid())
  qrCodeId  String
  qrCode    QRCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([qrCodeId, moduleId])
}

model TechnicalDocument {
  id          String   @id @default(cuid())
  title       String
  category    String   // "maintenance", "cleaning", "safety", etc.
  description String?
  content     String?  // Markdown hoặc HTML
  fileUrl     String?  // PDF file path
  fileName    String?
  fileSize    Int?
  mimeType    String?
  storageKey  String?  // file in private storage (outside public/)
  visibility  DocVisibility @default(ALL_STAFF)
  departments String[] // used when visibility = DEPARTMENT
  minRole     Role?    // used when visibility = ROLE_MIN
  uploadedById String?
  uploadedBy  User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Menu {
  id          String     @id @default(cuid())
  name        String
  description String?
  fileUrl     String?   // PDF, image, or flipbook URL
  fileType    String?   // "pdf" | "image" | "flipbook"
  flipbookId  String?
  flipbook    Flipbook?  @relation(fields: [flipbookId], references: [id], onDelete: SetNull)
  items       MenuItem[]
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Flipbook {
  id          String   @id @default(cuid())
  name        String
  description String?
  pages       String[] // Array of image URLs
  menus       Menu[]   // Many menus can use the same flipbook
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MenuItem {
  id          String   @id @default(cuid())
  menuId      String
  menu        Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float?
  image       String?
  category    String?  // "appetizer", "main", "dessert", etc.
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  name        String
  type        String   // "gym" | "bar" | "business-center"
  description String
  images      String[] // Array of image URLs (PostgreSQL supports arrays)
  hours       String?
  location    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Information {
  id          String   @id @default(cuid())
  category    String   // "wifi" | "phone" | "tv" | "room-info"
  title       String
  content     String
  icon        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FloorPlan {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?  // Floor plan image/PDF
  fileType    String?  // "image" | "pdf"
  rooms       Room[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Room {
  id          String   @id @default(cuid())
  floorPlanId String
  floorPlan   FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  number      String
  type        String   // "standard" | "deluxe" | "suite" | "villa"
  description String?
  x           Float?   // X coordinate for clickable area (0-100 percentage)
  y           Float?   // Y coordinate for clickable area (0-100 percentage)
  width       Float?   // Width percentage
  height      Float?   // Height percentage
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QRCodeScan {
  id          String   @id @default(cuid())
  qrCodeId    String
  qrCode      QRCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  scannedAt   DateTime @default(now())
  ipAddress   String?
  userAgent   String?
}


// ---------------------------------------------------------------------------
// Internal area: accounts, sessions, audit
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
}

enum DocVisibility {
  ALL_STAFF   // every active internal user
  DEPARTMENT  // only users of the listed departments
  ROLE_MIN    // users with role >= minRole
  PRIVATE     // admins and the uploader only
}

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  name             String
  passwordHash     String
  role             Role                @default(STAFF)
  department       String?
  isActive         Boolean             @default(true)
  failedAttempts   Int                 @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  sessions         Session[]
  documents        TechnicalDocument[]
  assignedFeedback Feedback[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique // sha256 of the cookie token; the raw token is never stored
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  action    String   // e.g. auth.login, document.download, feedback.update
  entity    String?
  entityId  String?
  meta      Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Customer feedback
// ---------------------------------------------------------------------------

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

model Feedback {
  id            String          @id @default(cuid())
  qrCodeId      String?
  qrCode        QRCode?         @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  venue         String          // hotel | restaurant | spa | other
  location      String?         // room / table number (optional)
  overallRating Int             // 1..5
  ratings       Json?           // per-criteria ratings 1..5
  npsScore      Int?            // 0..10
  comment       String?
  guestName     String?
  contact       String?         // phone / email (optional, PII)
  language      String          @default("vi")
  status        FeedbackStatus  @default(NEW)
  assigneeId    String?
  assignee      User?           @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  internalNote  String?
  ipHash        String?
  events        FeedbackEvent[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([overallRating])
  @@index([assigneeId])
}

model FeedbackEvent {
  id         String   @id @default(cuid())
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  userId     String?
  userEmail  String?
  type       String   // status | assign | note
  detail     String?
  createdAt  DateTime @default(now())

  @@index([feedbackId])
}
